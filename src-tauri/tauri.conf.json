{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Self-Planning",
  "version": "0.1.1",
  "identifier": "com.gamecoderstudios.self-planning",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Self-Planning",
        "width": 960,
        "height": 760,
        "minWidth": 720,
        "minHeight": 600
      },
      {
        "label": "weekly-review",
        "title": "Weekly Review",
        "url": "index.html?surface=weekly-review",
        "width": 900,
        "height": 760,
        "minWidth": 720,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
