{
  "name": "self-planning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run check:rust && npm run typecheck && npm run lint && npm run test && npm run check:fallow",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "check:fallow": "fallow audit",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --tsgo",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "24.0.14",
    "@types/turndown": "^5.0.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-svelte": "3.22.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "3.4.0",
    "svelte-check": "4.7.4",
    "typescript": "6.0.2",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "marked": "^18.0.9",
    "quill-next": "^2.2.6",
    "svelte": "5.56.8",
    "turndown": "^7.2.4"
  }
}
